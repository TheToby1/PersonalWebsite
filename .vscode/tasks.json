{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run-backend",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/BackendFunctions"
      },
      "isBackground": true
    },
    {
      "label": "run-frontend",
      "type": "shell",
      "command": "dotnet run --urls http://localhost:5242",
      "options": {
        "cwd": "${workspaceFolder}/Client"
      },
      "isBackground": true
    },
    {
      "label": "run-all",
      "dependsOn": [
        "run-backend",
        "run-frontend"
      ],
      "dependsOrder": "parallel"
    }
  ]
}