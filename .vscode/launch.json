{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Azure Functions",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "run-backend",
      "processId": "${command:azureFunctions.pickProcess}"
    },
    {
      "name": "Frontend: Blazor WASM",
      "type": "blazorwasm",
      "request": "launch",
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}/Client",
      "url": "http://localhost:5242"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack Debug",
      "configurations": [
        "Backend: Azure Functions",
        "Frontend: Blazor WASM"
      ],
      "stopAll": true
    }
  ]
}