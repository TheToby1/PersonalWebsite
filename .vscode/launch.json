{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Azure Functions",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "dotnet",
      "args": [
        "exec",
        "--depsfile",
        "${workspaceFolder}/BackendFunctions/bin/Debug/net8.0/PersonalWebsite.BackendFunctions.deps.json",
        "--runtimeconfig",
        "${workspaceFolder}/BackendFunctions/bin/Debug/net8.0/PersonalWebsite.BackendFunctions.runtimeconfig.json",
        "${env:HOME}/.azure-functions-core-tools/4/func/func.dll",
        "start",
        "--port",
        "7071",
        "--no-build"
      ],
      "cwd": "${workspaceFolder}/BackendFunctions",
      "env": {
        "AZURE_FUNCTIONS_ENVIRONMENT": "Development",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend: Blazor WASM",
      "type": "blazorwasm-companion",
      "request": "launch",
      "preLaunchTask": "build-frontend",
      "cwd": "${workspaceFolder}/Client",
      "url": "http://localhost:5242",
      "browser": "chrome"
    },
    {
      "name": "Attach to .NET Functions",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:azureFunctions.pickProcess}"
    }
  ]
}